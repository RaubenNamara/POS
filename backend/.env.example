# ---- Copy to .env and fill in. Never commit .env. -------------------------------
APP_NAME="Duka Shop"
APP_ENV=production
APP_KEY=                       # php artisan key:generate
APP_DEBUG=false                # MUST be false in production (hides SQL/stack traces)
APP_URL=https://shop.example.com
APP_TIMEZONE=Africa/Kampala

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shop
DB_USERNAME=shop_user
DB_PASSWORD=

# Web app and API are served from the same domain (cookie session + CSRF).
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=shop.example.com

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# First owner account, created by `php artisan db:seed` (change the password after first login).
SHOP_OWNER_EMAIL=owner@example.com
SHOP_OWNER_NAME="Shop Owner"
SHOP_OWNER_PASSWORD=

# Full path if mysqldump is not on PATH (used by `php artisan shop:backup`).
MYSQLDUMP_PATH=mysqldump

MAIL_MAILER=log

# Google sign-in (OAuth client id) and Maps (browser key: Maps JS + Places, restricted to your domain;
# server key: Geocoding API). Without GOOGLE_MAPS_SERVER_KEY, pay-on-delivery cannot be offered.
GOOGLE_CLIENT_ID=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=

# Flutterwave (https://dashboard.flutterwave.com > Settings > API keys). Use test keys first.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_PAYMENT_OPTIONS=mobilemoneyuganda,card

# Districts where pay on delivery is offered (matched against Google geocoding).
COD_DISTRICTS=Kampala,Wakiso
COD_FALLBACK_RADIUS_KM=0
SHOP_LAT=0.3476
SHOP_LNG=32.5825
